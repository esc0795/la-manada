---
import { Navbar } from "../components/Navbar.tsx";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "La Manada - Guardería & Hotel Canino",
	description = "El segundo hogar de tu mejor amigo. Cuidado profesional, paseos, socialización y hospedaje con amor.",
} = Astro.props;

// Normalizar base URL para enlaces y assets del head
const rawBase = import.meta.env.BASE_URL || "/";
const baseUrl = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const faviconPng = `${baseUrl}favicon.png`;
const favicon32 = `${baseUrl}favicon-32x32.png`;
const appleTouchIcon = `${baseUrl}apple-touch-icon.png`;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- Favicon de la huella con fondo verde #2b694b -->
		<link rel="icon" type="image/png" sizes="32x32" href={favicon32} />
		<link rel="icon" type="image/png" sizes="192x192" href={faviconPng} />
		<link rel="apple-touch-icon" href={appleTouchIcon} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Google Fonts: Londrina Solid (Titulares/Display) & Montserrat (Cuerpo/Legibilidad) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Londrina+Solid:wght@300;400;900&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-[#794d31] min-h-screen text-white antialiased m-0 flex flex-col" style="background-color: #794d31;">
		<!-- Navegación principal persistente -->
		<Navbar client:load />

		<!-- Contenido de las páginas -->
		<div class="flex-grow">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	:root {
		--font-display: 'Londrina Solid', cursive, sans-serif;
		--font-body: 'Montserrat', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		overflow-x: hidden;
		background-color: #794d31;
		font-family: var(--font-body);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	/* Tipografía para encabezados inspirada en afiches modernos/bold */
	h1,
	h2,
	h3,
	h4,
	h5,
	h6,
	.font-display,
	.font-title {
		font-family: 'Londrina Solid', var(--font-display), cursive, sans-serif !important;
		letter-spacing: 0.02em;
		line-height: 1.15;
		font-weight: 400;
	}

	/* Utilidades rápidas */
	.font-body {
		font-family: var(--font-body);
	}
</style>
