---
// Componente Hero Section de La Manada
interface Props {
	whatsappPhone?: string;
}

const { whatsappPhone = "50600000000" } = Astro.props;

// Normalizar base URL para compatibilidad con GitHub Pages y local
const rawBase = import.meta.env.BASE_URL || "/";
const baseUrl = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const hotelImg = `${baseUrl}images/hotel-guarderia-canina.jpg`;
const etologiaImg = `${baseUrl}images/etologia-canina.jpg`;
const heroBgImg = `${baseUrl}images/hero-pets-bg.jpg`;

const hotelWhatsAppUrl = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(
	"¡Hola! Me gustaría conocer más detalles sobre el Hotel y Guardería Canina en La Manada."
)}`;

const etologiaWhatsAppUrl = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(
	"¡Hola! Me gustaría conocer más sobre el servicio de Etología Canina y asesoría de comportamiento en La Manada."
)}`;
---

<section class="hero-section" id="inicio">
	<!-- Fondo dinámico e interactivo alusivo a mascotas -->
	<div class="dynamic-hero-bg-container" aria-hidden="true">
		<img
			src={heroBgImg}
			alt="Mascotas felices jugando en La Manada resort"
			class="dynamic-hero-bg-img"
			loading="eager"
			decoding="async"
			id="hero-dynamic-bg"
		/>
		<div class="dynamic-bg-overlay dynamic-bg-overlay-gradient"></div>
		<div class="dynamic-bg-overlay dynamic-bg-overlay-radial"></div>
		<div class="dynamic-bg-overlay dynamic-bg-overlay-vignette"></div>

		<!-- Elementos flotantes interactivos de huellas de mascotas -->
		<div class="floating-paws-layer">
			<span class="floating-paw paw-1">🐾</span>
			<span class="floating-paw paw-2">🐾</span>
			<span class="floating-paw paw-3">🐾</span>
			<span class="floating-paw paw-4">🐾</span>
			<span class="floating-paw paw-5">🐾</span>
		</div>
	</div>

	<!-- Luces ambientales sutiles contenidas -->
	<div class="ambient-glow ambient-glow-1" aria-hidden="true"></div>
	<div class="ambient-glow ambient-glow-2" aria-hidden="true"></div>

	<div class="hero-container">
		<!-- Encabezado del Hero -->
		<header class="hero-header">
			<h1 class="hero-title" style="font-family: 'Londrina Solid', cursive, sans-serif;">
				Cuidado, confort y comprensión <span class="highlight-text">para tu mejor amigo</span>
			</h1>
			<p class="hero-subtitle">
				Espacios diseñados para el bienestar canino, socialización en libertad y educación con base científica y amor.
			</p>
		</header>

		<!-- Grid de 2 Elementos Principales -->
		<div class="hero-grid">
			<!-- Elemento 1: Hotel y guardería canina -->
			<article class="hero-card" id="hotel-guarderia">
				<div class="card-media">
					<img
						src={hotelImg}
						alt="Hotel y guardería canina con perros felices jugando en áreas verdes y descanso confortable"
						class="card-image"
						loading="eager"
						decoding="async"
					/>
					<div class="media-overlay"></div>
					<div class="media-tag">
						<span>Hospedaje & Guardería</span>
					</div>
				</div>

				<div class="card-content">
					<h2 class="card-title">Hotel y guardería canina</h2>
					<p class="card-description">
						Un segundo hogar seguro y divertido. Amplias áreas verdes, socialización guiada, confortables zonas de descanso y atención personalizada las 24 horas para que tu perrito disfrute al máximo mientras estás fuera.
					</p>
					
					<!-- Características sin emojis -->
					<div class="card-features">
						<span class="feature-pill">Áreas verdes seguras</span>
						<span class="feature-pill">Supervisión 24/7</span>
						<span class="feature-pill">Descanso prémium</span>
					</div>

					<div class="card-action">
						<a
							href={hotelWhatsAppUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="btn-conocer-mas btn-hotel"
							aria-label="Conocer más sobre Hotel y guardería canina"
						>
							<span>Conocer más</span>
							<svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					</div>
				</div>
			</article>

			<!-- Elemento 2: Etología canina -->
			<article class="hero-card" id="etologia-canina">
				<div class="card-media">
					<img
						src={etologiaImg}
						alt="Especialista en etología canina trabajando con perro en adiestramiento positivo y comunicación"
						class="card-image"
						loading="eager"
						decoding="async"
					/>
					<div class="media-overlay"></div>
					<div class="media-tag tag-etologia">
						<span>Comportamiento Canino</span>
					</div>
				</div>

				<div class="card-content">
					<h2 class="card-title">Etología canina</h2>
					<p class="card-description">
						Comprende las emociones y la conducta de tu compañero. Tratamos problemas de comportamiento, ansiedad, miedos y reactividad con metodologías respetuosas y científicas para fortalecer el vínculo familiar.
					</p>

					<!-- Características sin emojis -->
					<div class="card-features">
						<span class="feature-pill">Refuerzo positivo</span>
						<span class="feature-pill">Diagnóstico personalizado</span>
						<span class="feature-pill">Vínculo familiar</span>
					</div>

					<div class="card-action">
						<a
							href={etologiaWhatsAppUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="btn-conocer-mas btn-etologia"
							aria-label="Conocer más sobre Etología canina"
						>
							<span>Conocer más</span>
							<svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					</div>
				</div>
			</article>
		</div>
	</div>
</section>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Londrina+Solid:wght@300;400;900&display=swap');

	/* Fondo dinámico de mascotas con movimiento suave */
	.dynamic-hero-bg-container {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
	}

	.dynamic-hero-bg-img {
		position: absolute;
		top: -5%;
		left: -5%;
		width: 110%;
		height: 110%;
		object-fit: cover;
		object-position: center 35%;
		will-change: transform;
		transform: scale(1.04) translate(var(--mouse-x, 0px), var(--mouse-y, 0px));
		transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
		animation: heroKenBurns 30s ease-in-out infinite alternate;
		filter: brightness(0.72) saturate(1.15) contrast(1.06);
	}

	@keyframes heroKenBurns {
		0% {
			transform: scale(1.04) translate(0, 0);
		}
		50% {
			transform: scale(1.11) translate(-1.8%, 1.2%);
		}
		100% {
			transform: scale(1.06) translate(1.4%, -0.8%);
		}
	}

	/* Capas de gradientes para asegurar legibilidad suprema */
	.dynamic-bg-overlay {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.dynamic-bg-overlay-gradient {
		background: linear-gradient(
			180deg,
			rgba(43, 105, 75, 0.68) 0%,
			rgba(121, 77, 49, 0.76) 45%,
			rgba(35, 23, 15, 0.92) 100%
		);
		mix-blend-mode: multiply;
	}

	.dynamic-bg-overlay-radial {
		background: radial-gradient(
			circle at 50% 25%,
			rgba(0, 0, 0, 0.25) 0%,
			rgba(0, 0, 0, 0.68) 70%,
			rgba(0, 0, 0, 0.88) 100%
		);
	}

	.dynamic-bg-overlay-vignette {
		box-shadow: inset 0 0 120px 40px rgba(0, 0, 0, 0.65);
	}

	/* Elementos flotantes interactivos de huellitas */
	.floating-paws-layer {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.floating-paw {
		position: absolute;
		opacity: 0.16;
		user-select: none;
		animation: floatPaw 20s ease-in-out infinite;
	}

	.paw-1 {
		top: 14%;
		left: 7%;
		font-size: 1.8rem;
		animation-duration: 22s;
		animation-delay: 0s;
	}

	.paw-2 {
		top: 68%;
		left: 10%;
		font-size: 1.4rem;
		animation-duration: 26s;
		animation-delay: 4s;
	}

	.paw-3 {
		top: 22%;
		right: 9%;
		font-size: 2.1rem;
		animation-duration: 24s;
		animation-delay: 2s;
	}

	.paw-4 {
		top: 76%;
		right: 12%;
		font-size: 1.5rem;
		animation-duration: 28s;
		animation-delay: 6s;
	}

	.paw-5 {
		top: 48%;
		left: 50%;
		font-size: 1.3rem;
		animation-duration: 30s;
		animation-delay: 8s;
	}

	@keyframes floatPaw {
		0% {
			transform: translateY(0) rotate(0deg) scale(1);
			opacity: 0.12;
		}
		50% {
			transform: translateY(-28px) rotate(16deg) scale(1.12);
			opacity: 0.22;
		}
		100% {
			transform: translateY(0) rotate(0deg) scale(1);
			opacity: 0.12;
		}
	}

	/* Contenedor principal de la sección: centrado riguroso sin desbordes */
	.hero-section {
		position: relative;
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		padding: 2.25rem 1rem 3.75rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	@media (min-width: 640px) {
		.hero-section {
			padding: 2.75rem 1.25rem 4.5rem;
		}
	}

	@media (min-width: 1024px) {
		.hero-section {
			padding: 3.5rem 1.5rem 5.5rem;
		}
	}

	/* Luces ambientales contenidas */
	.ambient-glow {
		position: absolute;
		border-radius: 9999px;
		filter: blur(80px);
		pointer-events: none;
		z-index: 0;
		opacity: 0.28;
	}

	.ambient-glow-1 {
		width: 280px;
		height: 280px;
		top: 5%;
		left: 15%;
		background: radial-gradient(circle, #2b694b 0%, transparent 70%);
	}

	.ambient-glow-2 {
		width: 300px;
		height: 300px;
		bottom: 10%;
		right: 15%;
		background: radial-gradient(circle, #d4a359 0%, transparent 70%);
	}

	/* Contenedor central simétrico */
	.hero-container {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 1160px;
		margin: 0 auto;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* Encabezado centrado */
	.hero-header {
		text-align: center;
		width: 100%;
		max-width: 800px;
		margin: 0 auto 2.25rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		box-sizing: border-box;
	}

	@media (min-width: 768px) {
		.hero-header {
			margin-bottom: 3rem;
		}
	}


	.hero-title {
		font-family: 'Londrina Solid', cursive, sans-serif !important;
		font-size: 2.35rem;
		font-weight: 400;
		line-height: 1.12;
		color: #ffffff;
		margin: 0 0 0.95rem;
		letter-spacing: 0.02em;
		text-shadow: 0 3px 12px rgba(0, 0, 0, 0.4);
	}

	@media (min-width: 480px) {
		.hero-title {
			font-size: 2.85rem;
		}
	}

	@media (min-width: 768px) {
		.hero-title {
			font-size: 3.5rem;
			margin-bottom: 1.15rem;
		}
	}

	@media (min-width: 1024px) {
		.hero-title {
			font-size: 4.15rem;
		}
	}

	.highlight-text {
		font-family: inherit;
		display: inline;
		color: #fef08a;
		background: linear-gradient(135deg, #fffbeb 0%, #fef3a1 48%, #fde68a 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		text-shadow: 0 2px 14px rgba(254, 240, 138, 0.4);
	}

	.hero-subtitle {
		font-family: var(--font-body);
		font-size: 0.98rem;
		line-height: 1.6;
		color: #f1f5f9;
		margin: 0;
		max-width: 640px;
		opacity: 0.95;
		font-weight: 400;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
	}

	@media (min-width: 640px) {
		.hero-subtitle {
			font-size: 1.12rem;
			line-height: 1.65;
		}
	}

	/* Grid de las 2 tarjetas: centrado exacto y simétrico */
	.hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.75rem;
		width: 100%;
		max-width: 100%;
		margin: 0 auto;
		box-sizing: border-box;
	}

	@media (min-width: 860px) {
		.hero-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2rem;
		}
	}

	@media (min-width: 1100px) {
		.hero-grid {
			gap: 2.5rem;
		}
	}

	/* Tarjeta individual */
	.hero-card {
		background: linear-gradient(175deg, rgba(35, 77, 56, 0.94) 0%, rgba(22, 52, 38, 0.98) 100%);
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 1.35rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: 0 10px 30px -4px rgba(0, 0, 0, 0.38), 0 3px 12px rgba(0, 0, 0, 0.22);
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, border-color 0.35s ease;
		position: relative;
		box-sizing: border-box;
		width: 100%;
	}

	@media (min-width: 640px) {
		.hero-card {
			border-radius: 1.5rem;
		}
	}

	.hero-card:hover {
		transform: translateY(-6px);
		border-color: rgba(254, 240, 138, 0.45);
		box-shadow: 0 18px 42px -4px rgba(0, 0, 0, 0.5), 0 0 20px rgba(43, 105, 75, 0.35);
	}

	/* Contenedor de Imagen */
	.card-media {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background-color: #1a3c2c;
	}

	.card-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
		transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.hero-card:hover .card-image {
		transform: scale(1.05);
	}

	.media-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(22, 52, 38, 0.85) 0%, rgba(22, 52, 38, 0.15) 50%, transparent 100%);
		pointer-events: none;
	}

	/* Etiquetas sin emojis: diseño limpio y moderno */
	.media-tag {
		position: absolute;
		top: 0.85rem;
		left: 0.85rem;
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.8rem;
		border-radius: 9999px;
		background: rgba(17, 24, 39, 0.78);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.2);
		color: #ffffff;
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
		z-index: 2;
	}

	@media (min-width: 640px) {
		.media-tag {
			top: 1rem;
			left: 1rem;
			font-size: 0.8rem;
			padding: 0.38rem 0.85rem;
		}
	}

	.tag-etologia {
		background: rgba(30, 41, 59, 0.82);
		border-color: rgba(147, 197, 253, 0.35);
		color: #e0f2fe;
	}

	/* Contenido de la tarjeta */
	.card-content {
		padding: 1.35rem 1.15rem 1.65rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		box-sizing: border-box;
	}

	@media (min-width: 640px) {
		.card-content {
			padding: 1.75rem 1.6rem 2rem;
		}
	}

	.card-title {
		font-family: var(--font-display);
		font-size: 1.55rem;
		font-weight: 900;
		color: #fef08a;
		background: linear-gradient(135deg, #fffbeb 0%, #fef3a1 48%, #fde68a 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		text-shadow: 0 2px 14px rgba(254, 240, 138, 0.35);
		margin: 0 0 0.75rem;
		line-height: 1.18;
		letter-spacing: 0.025em;
		text-transform: uppercase;
	}

	@media (min-width: 640px) {
		.card-title {
			font-size: 1.8rem;
		}
	}

	@media (min-width: 768px) {
		.card-title {
			font-size: 2rem;
		}
	}

	.card-description {
		font-family: var(--font-body);
		font-size: 0.95rem;
		line-height: 1.65;
		color: #f1f5f9; /* Tono gris claro con matices blancos */
		margin: 0 0 1.25rem;
		flex-grow: 1;
		font-weight: 400;
	}

	@media (min-width: 640px) {
		.card-description {
			font-size: 1rem;
			margin-bottom: 1.5rem;
		}
	}

	/* Píldoras de características: limpias, sin emojis */
	.card-features {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 1.5rem;
	}

	@media (min-width: 640px) {
		.card-features {
			gap: 0.55rem;
			margin-bottom: 1.75rem;
		}
	}

	.feature-pill {
		font-family: var(--font-body);
		display: inline-flex;
		align-items: center;
		padding: 0.32rem 0.75rem;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(241, 245, 249, 0.18);
		color: #f1f5f9; /* Tono gris claro con matices blancos */
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.hero-card:hover .feature-pill {
		background: rgba(255, 255, 255, 0.11);
		border-color: rgba(255, 255, 255, 0.18);
	}

	/* Zona de acción y Botón Conocer más: ajustado, NO estirado a la derecha */
	.card-action {
		margin-top: auto;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		width: 100%;
	}

	.btn-conocer-mas {
		font-family: var(--font-display);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		min-width: 150px;
		max-width: 100%;
		gap: 0.55rem;
		padding: 0.65rem 1.45rem;
		border-radius: 9999px;
		font-size: 1.15rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		text-decoration: none;
		cursor: pointer;
		transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
		box-shadow: 0 4px 14px -1px rgba(0, 0, 0, 0.3);
		border: 1px solid transparent;
		user-select: none;
		box-sizing: border-box;
	}

	@media (min-width: 640px) {
		.btn-conocer-mas {
			padding: 0.7rem 1.65rem;
			font-size: 1.2rem;
			min-width: 160px;
		}
	}

	/* Ambos botones Conocer más en color naranja */
	.btn-hotel,
	.btn-etologia {
		background: linear-gradient(135deg, #f97316 0%, #ea580c 50%, #c2410c 100%);
		color: #ffffff;
		border-color: rgba(254, 240, 138, 0.35);
	}

	.btn-hotel:hover,
	.btn-etologia:hover {
		background: linear-gradient(135deg, #fb923c 0%, #f97316 50%, #ea580c 100%);
		transform: translateY(-2px);
		box-shadow: 0 8px 22px -2px rgba(234, 88, 12, 0.65), 0 0 12px rgba(254, 240, 138, 0.3);
		border-color: rgba(254, 240, 138, 0.6);
	}

	.btn-hotel:active,
	.btn-etologia:active {
		transform: translateY(1px);
	}

	.btn-arrow {
		width: 1.05rem;
		height: 1.05rem;
		transition: transform 0.25s ease;
		flex-shrink: 0;
	}

	.btn-conocer-mas:hover .btn-arrow {
		transform: translateX(3px);
	}
</style>

<script>
	// Parallax suave interactivo con el cursor del usuario
	const heroSection = document.getElementById('inicio');
	const dynamicBg = document.getElementById('hero-dynamic-bg');

	if (heroSection && dynamicBg) {
		let isTicking = false;

		heroSection.addEventListener('mousemove', (e) => {
			const rect = heroSection.getBoundingClientRect();
			const x = (e.clientX - rect.left) / rect.width - 0.5;
			const y = (e.clientY - rect.top) / rect.height - 0.5;

			const targetX = x * -22;
			const targetY = y * -16;

			if (!isTicking) {
				window.requestAnimationFrame(() => {
					dynamicBg.style.setProperty('--mouse-x', `${targetX}px`);
					dynamicBg.style.setProperty('--mouse-y', `${targetY}px`);
					isTicking = false;
				});
				isTicking = true;
			}
		});

		heroSection.addEventListener('mouseleave', () => {
			dynamicBg.style.setProperty('--mouse-x', '0px');
			dynamicBg.style.setProperty('--mouse-y', '0px');
		});
	}
</script>
